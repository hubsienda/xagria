{
  "name": "xagria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run test:trade",
    "start": "next start",
    "lint": "next lint",
    "test:desk": "node --conditions=react-server tests/desk.test.mjs",
    "test:trade": "node --experimental-strip-types --experimental-loader=./tests/ts-loader.mjs tests/trade-flows.test.mjs && node --experimental-strip-types --experimental-loader=./tests/ts-loader.mjs tests/trade-catalogue-provider.test.mjs && node --experimental-strip-types --experimental-loader=./tests/ts-loader.mjs tests/trade-csv.test.mjs",
    "test:prices": "node --experimental-strip-types --experimental-loader=./tests/ts-loader.mjs tests/price-signals.test.mjs && node --experimental-strip-types --experimental-loader=./tests/ts-loader.mjs tests/price-csv.test.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.26",
    "next-intl": "^4.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
